[Unit]
Description=OpEx 5.0 Frontend
After=network.target

[Service]
Type=simple
User={{RUN_USER}}
Group={{RUN_GROUP}}
WorkingDirectory={{APP_DIR}}/frontend
EnvironmentFile={{APP_DIR}}/frontend/.env.production
Environment=NODE_ENV=production
ExecStart=/usr/bin/env bash -lc "cd {{APP_DIR}}/frontend && npm run start -- -p {{FRONTEND_PORT}}"
Restart=always
RestartSec=5
LimitNOFILE=65536
StandardOutput=append:/var/log/opex/frontend.log
StandardError=append:/var/log/opex/frontend-error.log

[Install]
WantedBy=multi-user.target
