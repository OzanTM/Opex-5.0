# ============================================
# OpEx 5.0 Backend - Production Environment
# Copy this file to backend/.env in production and replace all placeholders.
# ============================================

# Server
NODE_ENV=production
PORT=3001
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public

# Redis
REDIS_HOST=<redis_host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password>

# JWT
JWT_SECRET=<long-random-64plus-secret>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Session / Security
SESSION_TIMEOUT=1800000
MAX_CONCURRENT_SESSIONS=3
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION=900000
BCRYPT_SALT_ROUNDS=12

# Frontend URL (for CORS and links)
FRONTEND_URL=https://<your-frontend-domain>

# Email
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=<sendgrid_api_key>
EMAIL_FROM=<noreply@your-domain>
EMAIL_FROM_NAME=OpEx 5.0

# Upload
UPLOAD_PROVIDER=s3
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,png,gif

# AWS S3 (if UPLOAD_PROVIDER=s3)
AWS_ACCESS_KEY_ID=<aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<aws_secret_access_key>
AWS_REGION=<aws_region>
AWS_S3_BUCKET=<aws_bucket_name>

# Rate limit
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=2000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/opex.log

# Company
COMPANY_NAME=OpEx Company
COMPANY_LOGO_URL=https://<cdn-domain>/logo.png
